// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modelo de Cuenta

model Cuenta {
  cuentaId      Int          @id @default(autoincrement())
  nombre        String
  saldoInicial  Decimal      @db.Decimal(10, 2)
  cuentaBase    Movimiento[] @relation("cuentaBase")
  cuentaDestino Movimiento[] @relation("cuentaDestino")
  recurrentes   Recurrente[] @relation("cuentaRecurrente")
}

// Modelo de categoria

enum TipoMovimientoCategoria {
  INGRESO
  GASTO
}

model Categoria {
  categoriaId Int                     @id @default(autoincrement())
  nombre      String
  tipo        TipoMovimientoCategoria
  limite      Decimal?                @db.Decimal(10, 2)
  movimientos Movimiento[]            @relation("categoria")
  recurrentes Recurrente[]            @relation("categoriaRecurrente")

  @@unique([nombre, tipo])
}

enum TipoMovimiento {
  INGRESO
  GASTO
  TRANSFERENCIA
}

// Modelo de Movimiento

model Movimiento {
  movimientoId    Int            @id @default(autoincrement())
  nombre          String
  monto           Decimal        @db.Decimal(10, 2)
  tipo            TipoMovimiento
  fecha           DateTime       @default(now())
  nota            String?
  cuentaBaseId    Int
  cuentaDestinoId Int?
  categoriaId     Int?
  deudaId         Int?
  categoria       Categoria?     @relation("categoria", fields: [categoriaId], references: [categoriaId], onDelete: Restrict)
  cuentaBase      Cuenta         @relation("cuentaBase", fields: [cuentaBaseId], references: [cuentaId])
  cuentaDestino   Cuenta?        @relation("cuentaDestino", fields: [cuentaDestinoId], references: [cuentaId], onDelete: Restrict)
  deuda           Deuda?         @relation("pagos", fields: [deudaId], references: [deudaId], onDelete: Restrict)
}

// Modelo de Recurrente Subscripcion/pago recurrente

enum Periodicidad {
  MENSUAL
  ANUAL
}

model Recurrente {
  recurrenteId  Int                     @id @default(autoincrement())
  nombre        String
  monto         Decimal                 @db.Decimal(10, 2)
  tipo          TipoMovimientoCategoria
  periodicidad  Periodicidad
  proximaFecha  DateTime
  esSuscripcion Boolean                 @default(false)
  deudaId       Int?
  cuentaId      Int
  categoriaId   Int
  categoria     Categoria               @relation("categoriaRecurrente", fields: [categoriaId], references: [categoriaId], onDelete: Restrict)
  cuenta        Cuenta                  @relation("cuentaRecurrente", fields: [cuentaId], references: [cuentaId], onDelete: Restrict)
  deuda         Deuda?                  @relation("deuda", fields: [deudaId], references: [deudaId], onDelete: Restrict)
}

model Deuda {
  deudaId    Int          @id @default(autoincrement())
  nombre     String
  montoTotal Decimal      @db.Decimal(10, 2)
  nota       String?
  pagos      Movimiento[] @relation("pagos")
  recurrentes Recurrente[] @relation("deuda")
}
